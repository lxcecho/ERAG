# ============================================================
# ERAG 部署环境变量（复制为 .env 后按需修改）
# docker compose 默认读取同目录 .env 文件
# 标 [必改] 的需替换为真实值，其余为演示默认值
# ============================================================

# ===== 端口映射（宿主机:容器，避免宿主机端口冲突时改这里）=====
FRONTEND_PORT=80
BACKEND_PORT=8080
MYSQL_PORT=3306
REDIS_PORT=6379
MILVUS_PORT=19530
ES_PORT=9200
RABBITMQ_PORT=5672
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=root123
DB_USERNAME=root
DB_PASSWORD=root123

# ===== JWT 认证 [必改：生产更换强密钥] =====
JWT_SECRET=knowledge-ai-assistant-jwt-secret-key-2026-change-in-prod

# ===== LLM（OpenAI 兼容协议，RAG 与 Agent 层统一用 LangChain4j）[必改] =====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-deepseek-api-key
LLM_MODEL=deepseek-chat
LLM_STREAM_TIMEOUT=120

# ===== Embedding 向量化 [必改] =====
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-your-embedding-api-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
# 批量向量化分批大小（默认 64，dashscope ≤25，OpenAI ≤2048，Ollama 无硬限制）
AI_EMBEDDING_BATCH_SIZE=64

# ===== Milvus 向量库（容器内服务名 milvus，backend 环境覆盖）=====
MILVUS_HOST=milvus
MILVUS_PORT=19530

# ===== Elasticsearch（混合检索词法路，容器内服务名 elasticsearch）=====
ES_URIS=http://elasticsearch:9200
ES_USERNAME=
ES_PASSWORD=
ES_ENABLED=true

# ===== Redis 全局缓存（Prompt模板 / KB元数据 / AI统计 / 检索结果）=====
# 容器内服务名 redis；降级开关 spring.cache.type=none 可跳过 Redis 依赖
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
SPRING_CACHE_TYPE=redis

# ===== RabbitMQ（文档解析任务队列：重试/死信/幂等/补偿）=====
# 容器内服务名 rabbitmq；自定义账号（guest 仅限 localhost 跨容器不可用）
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=erag
RABBITMQ_PASSWORD=erag123
RABBITMQ_VHOST=/

# ===== 文件存储 MinIO（容器内服务名 minio）=====
KB_STORAGE_TYPE=minio
KB_STORAGE_MINIO_ENDPOINT=http://minio:9000
KB_STORAGE_MINIO_ACCESS_KEY=minioadmin
KB_STORAGE_MINIO_SECRET_KEY=minioadmin123
KB_STORAGE_MINIO_BUCKET=knowledge-files
# MinIO 服务自身 root 账号（须与上面 access/secret 一致）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# ===== Sentinel 控制台（限流/熔断；不启动 Dashboard 不影响应用，走本地规则兜底）=====
SENTINEL_DASHBOARD=localhost:8858
SENTINEL_CLIENT_PORT=8719

# ===== RAG 配置 =====
RAG_USE_DB_TEMPLATE=true
RAG_HISTORY_WINDOW_SIZE=5
HYBRID_ENABLED=false
RERANK_TYPE=noop

# ===== 知识治理（文档去重/版本/有效期/审核/质量评分）=====
KB_GOVERNANCE_ENABLED=true

# ===== 文档解析任务 MQ（RabbitMQ 模式总开关）=====
KB_PARSE_MQ_ENABLED=true
KB_PARSE_COMPENSATION_ENABLED=true
# 文档解析最大重试次数（本地 Ollama 较慢建议 5+，在线 API 可设 3）
KB_PARSE_MQ_MAX_RETRIES=5

# ===== 多租户（演示默认关闭；开启需配租户上下文）=====
TENANT_ENABLED=false

# ===== 异常告警（Webhook 可选）=====
ALERT_ENABLED=true
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=
