<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 Spring Boot 官方父 POM，统一管理 Spring 全家桶版本 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.knowledge</groupId>
    <artifactId>knowledge-backend</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>knowledge-backend</name>
    <description>企业级 AI 知识库助手后端</description>

    <!-- 聚合模块：common → infra → system → auth → kb → ai → agent → admin，按依赖顺序声明 -->
    <modules>
        <module>knowledge-common</module>
        <module>knowledge-infra</module>
        <module>knowledge-system</module>
        <module>knowledge-auth</module>
        <module>knowledge-kb</module>
        <module>knowledge-ai</module>
        <module>knowledge-agent</module>
        <module>knowledge-admin</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <!-- JDK 9+ 推荐使用 release 替代 source/target，编译时同时校验 API 可见性 -->
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- 第三方依赖版本集中声明（版本号均经 Maven Central 校验为最新稳定版，2026-08） -->
        <mybatis-plus.version>3.5.16</mybatis-plus.version>
        <mysql.version>9.3.0</mysql.version>
        <hutool.version>5.8.47</hutool.version>
        <knife4j.version>4.5.0</knife4j.version>
        <lombok.version>1.18.38</lombok.version>
        <jjwt.version>0.12.6</jjwt.version>
        <!-- LangChain4j 1.x GA（RAG 层基座）：0.35→1.18 为破坏性升级，StreamingResponseHandler/Response 等已移除 -->
        <langchain4j.version>1.18.0</langchain4j.version>
        <minio.version>8.5.17</minio.version>
        <ttl.version>2.14.5</ttl.version>

        <!-- Spring Cloud / Spring Cloud Alibaba（生产能力：Sentinel 限流熔断 + Actuator 治理） -->
        <!-- 版本矩阵（2026-08 校验）：SB 3.5.x ↔ SC 2025.0.x ↔ SCA 2025.0.0.0（内含 Sentinel 1.8.9） -->
        <spring-cloud.version>2025.0.0</spring-cloud.version>
        <spring-cloud-alibaba.version>2025.0.0.0</spring-cloud-alibaba.version>
        <sentinel.version>1.8.9</sentinel.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 内部模块版本统一 -->
            <dependency>
                <groupId>com.knowledge</groupId>
                <artifactId>knowledge-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.knowledge</groupId>
                <artifactId>knowledge-infra</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.knowledge</groupId>
                <artifactId>knowledge-system</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.knowledge</groupId>
                <artifactId>knowledge-auth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.knowledge</groupId>
                <artifactId>knowledge-kb</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.knowledge</groupId>
                <artifactId>knowledge-ai</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.knowledge</groupId>
                <artifactId>knowledge-agent</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- LangChain4j BOM：统一管理 LangChain4j 全家桶版本（RAG + Agent 层基座） -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>${langchain4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud BOM：与 Spring Boot 3.5.x 对齐（2025.0.x Northfields） -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud Alibaba BOM：统一管理 SCA 全家桶版本（含 Sentinel starter） -->
            <!-- 2025.0.0.0 适配 Spring Cloud 2025.0.x + Spring Boot 3.5.x，内含 sentinel 1.8.9 -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Sentinel 核心库版本兜底（本地规则数据源 FileRefreshableDataSource 等独立模块） -->
            <dependency>
                <groupId>com.alibaba.csp</groupId>
                <artifactId>sentinel-core</artifactId>
                <version>${sentinel.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba.csp</groupId>
                <artifactId>sentinel-datasource-extension</artifactId>
                <version>${sentinel.version}</version>
            </dependency>

            <!-- commons-io 统一锁定 2.20.0：Tika 文档解析依赖 2.16+ 的 UnsynchronizedBufferedReader，
                 避免被其他直接依赖（低版本 2.16.1）遮蔽导致运行时 NoClassDefFoundError -->
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>2.20.0</version>
            </dependency>

            <!-- MyBatis-Plus（Spring Boot 3 专用 starter） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- MyBatis-Plus jsqlparser 拦截器支持（3.5.6+ 拆分为独立模块）：
                 PaginationInnerInterceptor / TenantLineInnerInterceptor / TenantLineHandler 依赖于此 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- MySQL 驱动 -->
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql.version}</version>
            </dependency>

            <!-- Hutool 工具集 -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!-- Knife4j 接口文档（OpenAPI3 / Jakarta） -->
            <dependency>
                <groupId>com.github.xiaoymin</groupId>
                <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
                <version>${knife4j.version}</version>
            </dependency>

            <!-- JJWT（JWT 生成与解析，0.12.x 新 API：Jwts.SIG.HS256 / parseSignedClaims） -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>

            <!-- MinIO 对象存储 SDK -->
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>

            <!-- TransmittableThreadLocal：线程池复用场景下 ThreadLocal 上下文（租户/用户）安全传递 -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>transmittable-thread-local</artifactId>
                <version>${ttl.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 所有子模块共享依赖 -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <!-- 仓库：Maven Central + 阿里云镜像加速 -->
    <repositories>
        <repository>
            <id>spring-milestones</id>
            <name>Spring Milestones</name>
            <url>https://repo.spring.io/milestone</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>aliyun-public</id>
            <name>Aliyun Public</name>
            <url>https://maven.aliyun.com/repository/public</url>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${java.version}</release>
                        <encoding>UTF-8</encoding>
                        <!-- Lombok 注解处理器 -->
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Surefire：JDK 25+ 需要显式允许 Mockito 动态 agent 加载 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -XX:+EnableDynamicAgentLoading</argLine>
                </configuration>
            </plugin>

            <!-- ==================== Spotless：代码格式化 ==================== -->
            <!-- 使用：mvn spotless:check（检查） / mvn spotless:apply（自动修复） -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>2.43.0</version>
                <configuration>
                    <java>
                        <googleJavaFormat>
                            <version>1.19.2</version>
                            <style>AOSP</style>
                        </googleJavaFormat>
                        <removeUnusedImports/>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                        <indent>
                            <tabs>true</tabs>
                            <spacesPerTab>4</spacesPerTab>
                        </indent>
                    </java>
                </configuration>
            </plugin>

            <!-- ==================== JaCoCo：测试覆盖率 ==================== -->
            <!-- 使用：mvn test jacoco:report（生成报告在 target/site/jacoco/index.html） -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.14</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- 覆盖率门禁：当前 15%，渐进提升（目标 50%） -->
                    <execution>
                        <id>check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.15</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
